# =========================================================
# VerityAI Environment Configuration Template
# =========================================================
# Copy this file to .env and fill in your Gemini API key:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env

# Required for live AI analysis (Get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for analysis (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional Settings
# DEMO_MODE=true             # Set to true to test with keyword-only responses without an API key
# MAX_CHARS=8000             # Maximum character limit for input text
# MAX_IMAGE_MB=4             # Maximum file size (MB) for screenshot or PDF uploads
# RATE_LIMIT_PER_MIN=10      # Maximum checks allowed per minute per visitor
# TRUST_PROXY=true           # Set true when deployed behind reverse proxy (Render, Railway, Nginx)
# FRONTEND_URL=https://your-frontend.example.com   # Comma-separated origins if frontend is separate
# HOST=0.0.0.0
# PORT=8000
